# Copiar como .env.local y completar. Nunca subir .env.local a git.

# Firma de las sesiones (obligatoria en producción). Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Contraseña del usuario "admin" que se crea la primera vez (se pide cambiarla al entrar).
ADMIN_CLAVE_INICIAL=

# Supabase (Project Settings → API). Sin estas variables se usa un archivo local (.data/db.json).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Tráfico en vivo: HERE Routing API o Google Routes API. Sin clave se usa OSRM (sin tráfico).
HERE_API_KEY=
GOOGLE_MAPS_API_KEY=

# Servidor OSRM propio (opcional). Por defecto el público de demostración.
# OSRM_URL=https://router.project-osrm.org

# Solo en desarrollo: dirección del optimizador Python local.
OPTIMIZADOR_URL=http://127.0.0.1:8000
