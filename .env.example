# Copiar como .env.local y completar. Nunca subir .env.local a git.

# Supabase (Project Settings → API). Sin estas variables se usa un archivo local (.data/db.json).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Routes API (tráfico en vivo). Sin clave se usa OSRM (sin tráfico).
GOOGLE_MAPS_API_KEY=

# Servidor OSRM propio (opcional). Por defecto el público de demostración.
# OSRM_URL=https://router.project-osrm.org

# Solo en desarrollo: dirección del optimizador Python local.
OPTIMIZADOR_URL=http://127.0.0.1:8000
